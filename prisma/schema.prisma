// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  GERENTE
}

enum FinanceRecordType {
  INGRESO
  EGRESO
  FLETE
  ALQUILER
  GASTO_GENERAL
  COMPRA_VEHICULO
  VENTA_VEHICULO
  COSTO_OPERATIVO
  MANTENIMIENTO
}

enum VehicleStatusType {
  REGISTERED
  AVAILABLE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  SOLD
}

model User {
  id            String                 @id @default(cuid())
  name          String
  email         String                 @unique
  contactEmail  String?                @unique
  contactEmailVerified Boolean          @default(false)
  passwordHash  String
  role          Role                   @default(DIRECTOR)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  vehicles      Vehicle[]              @relation("VehicleCreator")
  statusUpdates VehicleStatusHistory[] @relation("StatusUpdater")
  adminUpdates  VehicleAdminHistory[]  @relation("VehicleAdminUpdater")
  photos        VehiclePhoto[]         @relation("PhotoUploader")
  emailVerification EmailVerification?
  complianceNotifications VehicleComplianceNotification[]
  financeRecords FinanceRecord[]       @relation("FinanceRecordCreator")
  auditLogs     AuditLog[]              @relation("AuditLogUser")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model FinanceRecord {
  id            String            @id @default(cuid())
  type          FinanceRecordType
  concept       String
  amount        Decimal           @db.Decimal(14, 2)
  date          DateTime
  client        String?
  vehicleId     String?
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  observations  String?
  costPerKm     Decimal?          @db.Decimal(14, 2)
  averageFreight Decimal?         @db.Decimal(14, 2)
  associatedCosts String?
  originDestination String?
  operatorName  String?
  operatorExpenses Decimal?       @db.Decimal(14, 2)
  startDate     DateTime?
  endDate       DateTime?
  mileageConsumed Int?
  vendor        String?
  buyer         String?
  paymentMethod String?
  documentNumber String?
  maintenanceType String?
  odometerKm    Int?
  invoiceUrl    String?
  invoiceFileName String?
  invoiceMimeType String?
  invoiceSize   Int?
  createdById   String?
  createdBy     User?             @relation("FinanceRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type])
  @@index([date])
  @@index([type, date])
  @@index([vehicleId])
  @@index([createdById])
}

model EmailVerification {
  id          String   @id @default(cuid())
  userId      String   @unique
  email       String
  codeHash    String
  expiresAt   DateTime
  lastSentAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model Vehicle {
  id            String                 @id @default(cuid())
  plate         String                 @unique
  vin           String?                @unique
  brand         String
  model         String
  year          Int
  currentStatus VehicleStatusType      @default(AVAILABLE)
  currentMileage Int?
  owner         String?
  assignedOperator String?
  observations  String?
  soatExpiry    DateTime?
  tecnomecanicaExpiry DateTime?
  vehicleTaxExpiry DateTime?
  pendingProcedures String?
  fines         String?
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdBy     User?                  @relation("VehicleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  statusHistory VehicleStatusHistory[]
  adminHistory  VehicleAdminHistory[]
  photos        VehiclePhoto[]
  complianceNotifications VehicleComplianceNotification[]
  financeRecords FinanceRecord[]

  @@index([plate])
  @@index([createdById])
  @@index([currentStatus])
  @@index([soatExpiry])
  @@index([tecnomecanicaExpiry])
  @@index([vehicleTaxExpiry])
}

model VehicleComplianceNotification {
  id          String   @id @default(cuid())
  vehicleId   String
  userId      String
  documentType String
  alertType   String
  expiryDate  DateTime
  sentAt      DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, userId, documentType, alertType, expiryDate])
  @@index([vehicleId])
  @@index([userId])
  @@index([sentAt])
}

model VehicleStatusHistory {
  id          String            @id @default(cuid())
  vehicleId   String
  statusType  VehicleStatusType
  description String?
  date        DateTime          @default(now())
  updatedById String?
  createdAt   DateTime          @default(now())
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  updatedBy   User?             @relation("StatusUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@index([updatedById])
  @@index([statusType])
}

model VehiclePhoto {
  id          String   @id @default(cuid())
  vehicleId   String
  url         String
  fileName    String
  mimeType    String
  size        Int
  description String?
  uploadedById String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedBy  User?    @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@index([uploadedById])
}

model VehicleAdminHistory {
  id          String   @id @default(cuid())
  vehicleId    String
  field       String
  oldValue    String?
  newValue    String?
  updatedById String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("VehicleAdminUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([vehicleId, createdAt])
  @@index([updatedById])
  @@index([createdAt])
}
